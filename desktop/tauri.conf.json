{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeonWatch",
  "version": "0.1.0",
  "identifier": "io.github.drobison00.neonwatch",
  "build": { "frontendDist": "dist" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "NeonWatch workstation health monitor",
    "longDescription": "The NeonWatch dashboard in its own window, desktop notifications that open it at their issue, and a tray icon showing the worst open severity.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
